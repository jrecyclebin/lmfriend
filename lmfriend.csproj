<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>lmfriend</AssemblyName>
    <RootNamespace>LmFriend</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- AOT: a single self-contained binary, so Claude Desktop can spawn us with no runtime installed. -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
  </ItemGroup>

</Project>
